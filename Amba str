  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: white;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* =========================
       INTRO AMBA STORE
    ========================= */

    #intro {
      position: fixed;
      inset: 0;
      z-index: 99999;

      background:
        radial-gradient(circle at center, #312e81, #0f172a 70%);

      display: flex;
      justify-content: center;
      align-items: center;

      opacity: 1;
      visibility: visible;

      transition:
        opacity .8s ease,
        visibility .8s ease;
    }

    #intro.hide {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .store-animation {
      text-align: center;
    }

    .store-animation span {
      display: inline-block;

      font-weight: 900;
      color: white;

      opacity: 0;

      transform: scale(.2) translateY(30px);

      text-shadow:
        0 0 5px #fff,
        0 0 15px #8b5cf6,
        0 0 30px #6366f1;

      transition:
        opacity .25s ease,
        transform .35s cubic-bezier(.17,.67,.38,1.4);
    }

    /* AMBA */

    .amba span {
      font-size: clamp(55px, 15vw, 110px);
      margin: 0 3px;
    }

    /* STORE */

    .store {
      margin-top: 5px;
    }

    .store span {
      font-size: clamp(30px, 8vw, 65px);
      margin: 0 2px;
      color: #c4b5fd;
    }

    /* Huruf aktif */

    .store-animation span.show {
      opacity: 1;

      transform: scale(1) translateY(0);

      animation: hurufGlow .45s ease;
    }

    @keyframes hurufGlow {

      0% {
        transform: scale(.5);
        filter: brightness(2);
      }

      50% {
        transform: scale(1.25);
        filter: brightness(2.5);
      }

      100% {
        transform: scale(1);
        filter: brightness(1);
      }

    }

    /* Tombol Lewati */

    .skip-btn {
      position: absolute;

      top: 25px;
      right: 20px;

      width: auto;

      padding: 10px 18px;

      background: rgba(255,255,255,.1);

      border:
        1px solid rgba(255,255,255,.25);

      border-radius: 20px;

      color: white;

      font-size: 14px;

      cursor: pointer;

      backdrop-filter: blur(10px);
    }

    .skip-btn:hover {
      background: rgba(255,255,255,.25);
      transform: none;
    }


    /* =========================
       HEADER
    ========================= */

    header {
      text-align: center;
      padding: 35px 20px;

      background:
        linear-gradient(
          135deg,
          #7c3aed,
          #2563eb
        );

      border-radius: 0 0 30px 30px;

      box-shadow:
        0 5px 20px rgba(0,0,0,.3);
    }

    header h1 {
      font-size: 32px;
      margin-bottom: 8px;
    }

    header p {
      color: #e0e7ff;
    }


    /* =========================
       CONTAINER
    ========================= */

    .container {
      max-width: 900px;
      margin: auto;
      padding: 25px 15px;
    }

    .category {
      margin-bottom: 30px;
    }

    .category h2 {
      margin-bottom: 15px;

      color: #c4b5fd;

      border-left:
        5px solid #8b5cf6;

      padding-left: 12px;
    }


    /* =========================
       CARD
    ========================= */

    .card {
      background:
        rgba(255,255,255,.08);

      border:
        1px solid rgba(255,255,255,.1);

      border-radius: 18px;

      padding: 20px;
      margin-bottom: 14px;

      backdrop-filter: blur(10px);

      transition: .2s;
    }

    .card:hover {
      transform: translateY(-3px);

      background:
        rgba(255,255,255,.12);
    }

    .card h3 {
      font-size: 19px;
      margin-bottom: 8px;
    }

    .price {
      color: #4ade80;

      font-size: 20px;

      font-weight: bold;

      margin-bottom: 8px;
    }

    .description {
      color: #cbd5e1;

      margin-bottom: 15px;

      line-height: 1.5;
    }


    /* =========================
       BUTTON
    ========================= */

    button {
      width: 100%;

      border: none;

      border-radius: 12px;

      padding: 13px;

      background: #22c55e;

      color: white;

      font-size: 16px;

      font-weight: bold;

      cursor: pointer;

      transition: .2s;
    }

    button:hover {
      background: #16a34a;

      transform: scale(1.02);
    }


    /* =========================
       FOOTER
    ========================= */

    footer {
      text-align: center;

      padding: 30px 15px;

      color: #94a3b8;
    }

    .wa {
      color: #4ade80;

      font-weight: bold;
    }

  </style>
</head>


