  <!-- ==================================
       JAVASCRIPT
  =================================== -->

  <script>

    const nomorWA =
      "6287755296046";


    const intro =
      document.getElementById("intro");


    const huruf =
      document.querySelectorAll(
        ".store-animation span"
      );


    /* =========================
       SUARA
    ========================= */

    let audioContext;


    function bunyi() {

      if (!audioContext) {

        audioContext =
          new (
            window.AudioContext ||
            window.webkitAudioContext
          )();

      }


      const oscillator =
        audioContext.createOscillator();


      const gain =
        audioContext.createGain();


      oscillator.type =
        "sine";


      oscillator.frequency.setValueAtTime(
        650,
        audioContext.currentTime
      );


      oscillator.frequency.exponentialRampToValueAtTime(
        900,
        audioContext.currentTime + 0.08
      );


      gain.gain.setValueAtTime(
        0.0001,
        audioContext.currentTime
      );


      gain.gain.exponentialRampToValueAtTime(
        0.25,
        audioContext.currentTime + 0.01
      );


      gain.gain.exponentialRampToValueAtTime(
        0.0001,
        audioContext.currentTime + 0.12
      );


      oscillator.connect(gain);

      gain.connect(
        audioContext.destination
      );


      oscillator.start();


      oscillator.stop(
        audioContext.currentTime + 0.13
      );

    }


    /* =========================
       ANIMASI HURUF
    ========================= */

    let index = 0;


    function tampilkanHuruf() {

      if (index >= huruf.length) {

        setTimeout(
          tutupIntro,
          1000
        );

        return;
      }


      const h =
        huruf[index];


      h.classList.add(
        "show"
      );


      bunyi();


      index++;


      setTimeout(
        tampilkanHuruf,
        300
      );

    }


    /* =========================
       TUTUP INTRO
    ========================= */

    function tutupIntro() {

      intro.classList.add(
        "hide"
      );


      setTimeout(
        () => {
          intro.remove();
        },
        900
      );

    }


    /* =========================
       LEWATI INTRO
    ========================= */

    function skipIntro() {

      tutupIntro();

    }


    /* =========================
       MULAI
    ========================= */

    window.addEventListener(
      "load",
      () => {

        setTimeout(
          tampilkanHuruf,
          400
        );

      }
    );


    /* =========================
       WHATSAPP
    ========================= */

    function pesan(jasa) {

      const pesanWA =
        "Halo kak 👋%0A%0A" +
        "Saya mau pesan:%0A" +
        "📦 " + jasa + "%0A%0A" +
        "Mohon info untuk proses selanjutnya ya kak 🙏";


      const link =
        "https://wa.me/" +
        nomorWA +
        "?text=" +
        pesanWA;


      window.open(
        link,
        "_blank"
      );

    }

  </script>

